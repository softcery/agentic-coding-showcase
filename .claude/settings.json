{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "caveman@caveman": false
  },
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run dev)",
      "Bash(npm run dev *)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run preview *)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test:slow)",
      "Bash(npm run test:slow *)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run dead)",
      "Bash(npm run check)",
      "Bash(npm run ai:arena)",
      "Bash(npm run ai:arena *)",
      "Bash(npm run ai:tune)",
      "Bash(npm run ai:tune *)",
      "Bash(npm run turn:dev)",
      "Bash(npm run turn:dev *)",
      "Bash(node --import tsx --test tests/*.test.ts)",
      "Bash(RUN_SLOW=1 node --import tsx --test tests/*.test.ts)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint .)",
      "Bash(npx eslint . --fix)",
      "Bash(npx prettier --write .)",
      "Bash(npx prettier --check .)",
      "Bash(npx knip)",
      "Bash(npx vite)",
      "Bash(npx vite build)",
      "Bash(npx vite preview)",
      "Bash(npx tsx *)",
      "Bash(tsx *)",
      "Bash(tsmap *)",
      "Bash(rg *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list)",
      "Bash(git branch --list *)",
      "Bash(git add *)"
    ]
  },
  "outputStyle": "Caveman"
}
